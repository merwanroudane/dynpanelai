include README.md
include LICENSE
include pyproject.toml

# Bundled real datasets (needed at runtime by dynpanelai.datasets)
recursive-include dynpanelai/datasets/data *.parquet

# Documentation and runnable examples
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py

# Never ship reference literature or third-party source archives
prune _references
global-exclude *.pdf
global-exclude *.zip
global-exclude *.tar.gz
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
